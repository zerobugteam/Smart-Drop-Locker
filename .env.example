# Port lokal untuk development
PORT=3000

# PostgreSQL connection string (Neon / Supabase)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/smart_drop_locker?sslmode=require

# Token Vercel Blob (otomatis terisi di Vercel jika Blob Storage diaktifkan;
# jika kosong saat jalan di localhost, foto otomatis disimpan ke public/uploads/)
BLOB_READ_WRITE_TOKEN=

# API Key untuk autentikasi request dari ESP32-CAM (opsional saat dev jika kosong)
ESP32_API_KEY=ganti-dengan-token-rahasia-esp32

