<%- include("partials/header") %>
<%- include("partials/navbar", { activePage }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">Scan Foto Barcode</h1>
    <p class="page-subtitle">Unggah foto barcode atau QR paket untuk menguji kecocokan resi dengan data loker.</p>
  </div>
  <a class="btn-console btn-console-secondary" href="/log">
    <i class="bi bi-clock-history" aria-hidden="true"></i>
    <span>Lihat Log Akses</span>
  </a>
</div>

<section class="console-panel">
  <% if (err) { %>
    <div class="console-alert console-alert-danger" role="alert">
      <div><i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i><%= err %></div>
    </div>
  <% } %>

  <form method="post" action="/scan" enctype="multipart/form-data" class="row g-3">
    <div class="col-12">
      <label class="console-label" for="fotoInput">Pilih File Foto Barcode (JPG / PNG, maks 5 MB)</label>
      <input class="console-input"
             id="fotoInput"
             type="file"
             name="foto"
             accept="image/jpeg,image/png"
             required>
    </div>

    <div class="col-12" id="scanPreviewWrapper" hidden>
      <div class="scan-preview-box">
        <div class="muted-text small mb-2">Pratinjau foto sebelum diproses:</div>
        <img id="scanPreviewImg"
             class="scan-preview-img"
             src=""
             width="480"
             height="320"
             alt="Pratinjau foto barcode yang dipilih">
      </div>
    </div>

    <div class="col-12 d-flex flex-wrap gap-2">
      <button type="submit" class="btn-console btn-console-primary" data-loading-text="Memproses barcode...">
        <i class="bi bi-upc-scan" aria-hidden="true"></i>
        <span>Proses &amp; Validasi Barcode</span>
      </button>
      <a class="btn-console btn-console-secondary" href="/">Kembali ke Dashboard</a>
    </div>
  </form>
</section>

<%- include("partials/footer") %>
