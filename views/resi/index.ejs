<%- include("../partials/header") %>
<%- include("../partials/sidebar", { activePage }) %>

<div class="card-glass p-4 mb-3">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <h3 class="mb-1">Data Resi</h3>
      <div class="text-muted">Daftar resi yang boleh akses loker (valid/invalid).</div>
    </div>

    <div class="d-flex gap-2">
      <a class="btn btn-accent text-white px-3" href="/resi/add">
        <i class="bi bi-plus-circle me-2"></i>Tambah
      </a>
    </div>
  </div>

  <form class="row g-2 mt-3" method="get" action="/resi">
    <div class="col-md-10">
      <input class="form-control" name="q" value="<%= q %>" placeholder="Cari nomor resi / nama paket...">
    </div>
    <div class="col-md-2 d-grid">
      <button class="btn btn-outline-light" type="submit">
        <i class="bi bi-search me-2"></i>Cari
      </button>
    </div>
  </form>
</div>

<div class="card-glass p-3">
  <div class="table-responsive">
    <table class="table table-dark table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Nomor Resi</th>
          <th>Nama Paket</th>
          <th>Status</th>
          <th>Dibuat</th>
          <th width="270">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (items.length > 0) { %>
          <% items.forEach((r) => { %>
            <tr>
              <td class="fw-semibold"><%= r.nomor_resi %></td>
              <td class="text-muted"><%= r.nama_paket || "-" %></td>
              <td>
                <% if (r.status === "valid") { %>
                  <span class="badge text-bg-success">VALID</span>
                <% } else { %>
                  <span class="badge text-bg-secondary">INVALID</span>
                <% } %>
              </td>
              <td class="text-muted"><%= r.created_at %></td>
              <td>
                <div class="d-flex gap-2 flex-wrap">
                  <a class="btn btn-sm btn-outline-light" href="/resi/<%= r.id %>">
                    <i class="bi bi-eye me-1"></i>Detail
                  </a>

                  <form method="post" action="/resi/<%= r.id %>/toggle" class="m-0">
                    <button type="submit" class="btn btn-sm btn-outline-warning">
                      <i class="bi bi-arrow-repeat me-1"></i>Toggle
                    </button>
                  </form>

                  <form method="post" action="/resi/<%= r.id %>/delete" class="m-0"
                        onsubmit="return confirm('Yakin ingin menghapus resi ini?')">
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Hapus resi">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5" class="text-muted">Belum ada data resi.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include("../partials/footer") %>

