<%- include("../partials/header") %>
<%- include("../partials/navbar", { activePage }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">Detail &amp; Edit Resi</h1>
    <p class="page-subtitle">Perbarui informasi nomor resi, nama paket, atau status akses.</p>
  </div>
  <a class="btn-console btn-console-secondary" href="/resi">
    <i class="bi bi-arrow-left" aria-hidden="true"></i>
    <span>Kembali ke Data Resi</span>
  </a>
</div>

<% if (msg) { %>
  <div class="console-alert console-alert-ok" role="status">
    <div><i class="bi bi-check-circle me-2" aria-hidden="true"></i><%= msg %></div>
  </div>
<% } %>
<% if (err) { %>
  <div class="console-alert console-alert-danger" role="alert">
    <div><i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i><%= err %></div>
  </div>
<% } %>

<% if (data) { %>
  <section class="console-panel">
    <form method="post" action="/resi/<%= data.id %>/edit" class="row g-3">
      <div class="col-12 col-md-6">
        <label class="console-label" for="editNomorResi">Nomor Resi</label>
        <input class="console-input mono"
               id="editNomorResi"
               name="nomor_resi"
               value="<%= data.nomor_resi %>"
               required>
      </div>
      <div class="col-12 col-md-6">
        <label class="console-label" for="editStatusResi">Status Akses</label>
        <select class="console-select" id="editStatusResi" name="status">
          <option value="valid" <%= data.status === "valid" ? "selected" : "" %>>Valid (izinkan buka loker)</option>
          <option value="invalid" <%= data.status === "invalid" ? "selected" : "" %>>Invalid (tolak akses)</option>
        </select>
      </div>
      <div class="col-12 col-md-6">
        <label class="console-label" for="editNamaPaket">Nama Paket</label>
        <input class="console-input"
               id="editNamaPaket"
               name="nama_paket"
               value="<%= data.nama_paket || '' %>"
               placeholder="Kosongkan jika tidak ada">
      </div>
      <div class="col-12 col-md-6">
        <label class="console-label" for="resiCreatedAt">Waktu Dibuat (WIB)</label>
        <input class="console-input mono"
               id="resiCreatedAt"
               value="<%= data.created_at %>"
               disabled>
      </div>
      <div class="col-12 d-flex flex-wrap gap-2">
        <button type="submit" class="btn-console btn-console-primary" data-loading-text="Menyimpan perubahan...">
          <i class="bi bi-save" aria-hidden="true"></i>
          <span>Simpan Perubahan</span>
        </button>
        <a class="btn-console btn-console-secondary" href="/resi">Batal</a>
      </div>
    </form>
  </section>
<% } else { %>
  <section class="console-panel">
    <div class="empty-state">
      <div class="empty-state-title">Data resi tidak ditemukan</div>
      <p class="mb-3 small">Resi mungkin sudah dihapus atau ID tidak tersedia.</p>
      <a class="btn-console btn-console-secondary btn-console-sm" href="/resi">Kembali ke Data Resi</a>
    </div>
  </section>
<% } %>

<%- include("../partials/footer") %>
