<%- include("../partials/header") %>
<%- include("../partials/navbar", { activePage }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">Tambah Resi</h1>
    <p class="page-subtitle">Daftarkan nomor resi paket untuk validasi pembukaan loker.</p>
  </div>
  <a class="btn-console btn-console-secondary" href="/resi">
    <i class="bi bi-arrow-left" aria-hidden="true"></i>
    <span>Kembali ke Data Resi</span>
  </a>
</div>

<section class="console-panel">
  <% if (err) { %>
    <div class="console-alert console-alert-danger" role="alert">
      <div><i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i><%= err %></div>
    </div>
  <% } %>
  <% if (ok) { %>
    <div class="console-alert console-alert-ok" role="status">
      <div>
        <i class="bi bi-check-circle me-2" aria-hidden="true"></i><%= ok %>
        <a href="/resi" class="ms-2">Lihat daftar resi</a>
      </div>
    </div>
  <% } %>

  <form method="post" action="/resi/add" class="row g-3">
    <div class="col-12 col-md-6">
      <label class="console-label" for="nomorResi">Nomor Resi</label>
      <input class="console-input mono"
             id="nomorResi"
             name="nomor_resi"
             placeholder="Contoh: JX7733615817"
             required>
    </div>
    <div class="col-12 col-md-6">
      <label class="console-label" for="statusResi">Status Akses</label>
      <select class="console-select" id="statusResi" name="status">
        <option value="valid" selected>Valid (izinkan buka loker)</option>
        <option value="invalid">Invalid (tolak akses)</option>
      </select>
    </div>
    <div class="col-12">
      <label class="console-label" for="namaPaket">Nama Paket (opsional)</label>
      <input class="console-input"
             id="namaPaket"
             name="nama_paket"
             placeholder="Contoh: Paket Elektronik / Buku">
    </div>
    <div class="col-12 d-flex flex-wrap gap-2">
      <button type="submit" class="btn-console btn-console-primary" data-loading-text="Menyimpan resi...">
        <i class="bi bi-check2-circle" aria-hidden="true"></i>
        <span>Simpan Resi</span>
      </button>
      <a class="btn-console btn-console-secondary" href="/resi">Batal</a>
    </div>
  </form>
</section>

<%- include("../partials/footer") %>
