<%- include("partials/header") %>
<%- include("partials/navbar", { activePage }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">Kontrol Loker &amp; Aktivitas</h1>
    <p class="page-subtitle">Pantau status pintu loker, data resi valid, dan hasil pemindaian kamera loker.</p>
  </div>
  <a class="btn-console btn-console-primary" href="/resi/add">
    <i class="bi bi-plus-lg" aria-hidden="true"></i>
    <span>Tambah Resi</span>
  </a>
</div>

<% if (manualMsg) { %>
  <div class="console-alert console-alert-ok" role="status">
    <div>
      <i class="bi bi-unlock-fill me-2" aria-hidden="true"></i><%= manualMsg %>
    </div>
    <button type="button"
            class="btn-close btn-close-themed"
            aria-label="Tutup pemberitahuan"
            onclick="this.parentElement.remove()"></button>
  </div>
<% } %>

<div class="dashboard-top-grid">
  <section class="console-panel console-panel-focal" aria-labelledby="door-control-heading">
    <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
      <div>
        <h2 class="panel-heading" id="door-control-heading">Status Pintu Loker</h2>
        <p class="muted-text mb-0 small mt-1">
          Kondisi layanan: <strong>Aktif</strong>
        </p>
      </div>
      <% if (doorStatus === "BUKA") { %>
        <span class="status-chip status-chip-ok">
          <i class="bi bi-unlock" aria-hidden="true"></i>
          <span>Perintah BUKA aktif</span>
        </span>
      <% } else { %>
        <span class="status-chip status-chip-neutral">
          <i class="bi bi-lock" aria-hidden="true"></i>
          <span>Standby</span>
        </span>
      <% } %>
    </div>

    <div class="door-state-row">
      <div>
        <div class="door-state-label">Status Kunci Pintu</div>
        <div class="door-state-value <%= doorStatus === 'BUKA' ? 'is-open' : 'is-closed' %>">
          <i class="bi <%= doorStatus === 'BUKA' ? 'bi-unlock-fill' : 'bi-lock-fill' %>" aria-hidden="true"></i>
          <span><%= doorStatus === "BUKA" ? "TERBUKA" : "TERKUNCI" %></span>
        </div>
      </div>
      <div class="muted-text small">
        <%= doorStatus === "BUKA" ? "Pintu sedang dibuka, akan mengunci otomatis" : "Menunggu resi valid atau perintah manual" %>
      </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
      <button type="button"
              class="btn-console btn-console-danger"
              data-bs-toggle="modal"
              data-bs-target="#manualOpenModal">
        <i class="bi bi-unlock" aria-hidden="true"></i>
        <span>Buka Pintu Manual</span>
      </button>

      <a class="btn-console btn-console-secondary" href="/scan">
        <i class="bi bi-upc-scan" aria-hidden="true"></i>
        <span>Scan Uji Barcode</span>
      </a>
    </div>
  </section>

  <div class="telemetry-stack" aria-label="Ringkasan data loker">
    <section class="telemetry-row">
      <div>
        <div class="telemetry-label">Total Resi Terdaftar</div>
        <div class="telemetry-number"><%= stats.total_resi %></div>
        <div class="telemetry-meta">
          <%= stats.resi_valid %> valid, <%= stats.resi_invalid %> invalid
        </div>
      </div>
      <a class="btn-console btn-console-secondary btn-console-sm" href="/resi">
        Kelola Resi
      </a>
    </section>

    <section class="telemetry-row">
      <div>
        <div class="telemetry-label">Total Scan Hari Ini</div>
        <div class="telemetry-number"><%= stats.log_today %></div>
        <div class="telemetry-meta">
          <%= stats.log_ok %> berhasil, <%= stats.log_fail %> gagal
        </div>
      </div>
      <a class="btn-console btn-console-secondary btn-console-sm" href="/log">
        Semua Log
      </a>
    </section>
  </div>
</div>

<section class="console-panel" aria-labelledby="latest-log-heading">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h2 class="panel-heading" id="latest-log-heading">Log Akses Terbaru</h2>
    <a class="inline-link small" href="/log">Lihat seluruh riwayat</a>
  </div>

  <% if (latest.length > 0) { %>
    <div class="table-responsive">
      <table class="console-table">
        <thead>
          <tr>
            <th scope="col">Waktu (WIB)</th>
            <th scope="col">Nomor Resi</th>
            <th scope="col">Status</th>
            <th scope="col">Keterangan</th>
            <th scope="col">Foto</th>
          </tr>
        </thead>
        <tbody>
          <% latest.forEach((x) => { %>
            <tr>
              <td class="mono muted-text"><%= x.created_at %></td>
              <td class="resi-code"><%= x.nomor_resi || "-" %></td>
              <td>
                <% if (x.status === "berhasil") { %>
                  <span class="status-chip status-chip-ok">
                    <i class="bi bi-check-circle" aria-hidden="true"></i>
                    <span>Berhasil</span>
                  </span>
                <% } else { %>
                  <span class="status-chip status-chip-danger">
                    <i class="bi bi-x-circle" aria-hidden="true"></i>
                    <span>Gagal</span>
                  </span>
                <% } %>
              </td>
              <td class="muted-text"><%= x.pesan || "-" %></td>
              <td>
                <% if (x.foto_path) { %>
                  <button type="button"
                          class="thumb-btn"
                          data-foto-modal="1"
                          data-src="<%= x.foto_path %>"
                          data-caption="<%= (x.nomor_resi || '-') + ' (' + x.created_at + ')' %>"
                          aria-label="Lihat bukti foto resi <%= x.nomor_resi || x.created_at %>">
                    <img class="thumb-img"
                         src="<%= x.foto_path %>"
                         width="52"
                         height="52"
                         alt="Bukti foto resi <%= x.nomor_resi || 'tidak terbaca' %>">
                  </button>
                <% } else { %>
                  <span class="muted-text">-</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state">
      <div class="empty-state-title">Belum ada aktivitas scan</div>
      <p class="mb-3 small">Log akan tercatat otomatis saat kamera loker memindai paket atau saat kamu menguji barcode lewat Scan Manual.</p>
      <a class="btn-console btn-console-secondary btn-console-sm" href="/scan">Uji Scan Foto Barcode</a>
    </div>
  <% } %>
</section>

<!-- Modal Konfirmasi Buka Pintu Manual -->
<div class="modal fade" id="manualOpenModal" tabindex="-1" aria-labelledby="manualOpenModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content console-modal">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="manualOpenModalTitle">Konfirmasi Buka Pintu Manual</h2>
        <button type="button" class="btn-close btn-close-themed" data-bs-dismiss="modal" aria-label="Tutup"></button>
      </div>
      <div class="modal-body">
        <p class="mb-0">
          Kunci pintu loker akan dibuka secara manual selama sekitar 5 detik, lalu terkunci kembali secara otomatis.
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-console btn-console-secondary btn-console-sm" data-bs-dismiss="modal">Batal</button>
        <form action="/manual-open" method="post" class="m-0">
          <button type="submit" class="btn-console btn-console-danger btn-console-sm" data-loading-text="Mengirim perintah...">
            <i class="bi bi-unlock" aria-hidden="true"></i>
            <span>Ya, Buka Pintu</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Modal Pratinjau Foto -->
<div class="modal fade" id="fotoModal" tabindex="-1" aria-labelledby="fotoModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content console-modal">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="fotoModalTitle">Bukti Foto Scan</h2>
        <button type="button" class="btn-close btn-close-themed" data-bs-dismiss="modal" aria-label="Tutup"></button>
      </div>
      <div class="modal-body text-center">
        <img id="fotoModalImg" src="" width="640" height="480" alt="Pratinjau bukti foto scan" style="max-width:100%;height:auto;border-radius:4px;">
        <div class="mt-2 muted-text small mono" id="fotoModalCaption"></div>
      </div>
    </div>
  </div>
</div>

<%- include("partials/footer") %>
