<%- include("partials/header") %>
<%- include("partials/sidebar", { activePage }) %>

<div class="card-glass p-4 mb-3">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <h3 class="mb-1">Log Akses</h3>
      <div class="text-muted">Riwayat autentikasi barcode (berhasil/gagal) + bukti foto.</div>
    </div>
    <a class="btn btn-outline-light" href="/scan">
      <i class="bi bi-upc-scan me-2"></i>Scan Manual
    </a>
  </div>

  <form class="row g-2 mt-3" method="get" action="/log">
    <div class="col-md-5">
      <input class="form-control" name="q" value="<%= q %>" placeholder="Cari nomor resi...">
    </div>
    <div class="col-md-5">
      <select class="form-select" name="status">
        <option value="">Semua status</option>
        <option value="berhasil" <%= status === "berhasil" ? "selected" : "" %>>berhasil</option>
        <option value="gagal" <%= status === "gagal" ? "selected" : "" %>>gagal</option>
      </select>
    </div>
    <div class="col-md-2 d-grid">
      <button type="submit" class="btn btn-outline-light">
        <i class="bi bi-funnel me-1"></i>Filter
      </button>
    </div>
  </form>
</div>

<div class="card-glass p-3">
  <div class="table-responsive">
    <table class="table table-dark table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Waktu</th>
          <th>Nomor Resi</th>
          <th>Status</th>
          <th>Pesan</th>
          <th>Foto</th>
          <th class="text-center">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (logs.length > 0) { %>
          <% logs.forEach((l) => { %>
            <tr>
              <td class="text-muted"><%= l.created_at %></td>
              <td class="fw-semibold"><%= l.nomor_resi || "-" %></td>
              <td>
                <% if (l.status === "berhasil") { %>
                  <span class="badge text-bg-success">Berhasil</span>
                <% } else { %>
                  <span class="badge text-bg-danger">Gagal</span>
                <% } %>
              </td>
              <td class="text-muted"><%= l.pesan || "-" %></td>
              <td>
                <% if (l.foto_path) { %>
                  <a target="_blank" rel="noopener noreferrer" href="<%= l.foto_path %>">
                    <img
                      src="<%= l.foto_path %>"
                      style="width:70px;height:70px;object-fit:cover;border-radius:10px;border:1px solid rgba(255,255,255,.2);"
                      alt="foto">
                  </a>
                <% } else { %>
                  <span class="text-muted">-</span>
                <% } %>
              </td>
              <td class="text-center">
                <form method="post" action="/log/<%= l.id %>/delete" class="m-0"
                      onsubmit="return confirm('Yakin mau hapus log ini?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger" title="Hapus log">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6" class="text-muted text-center">Belum ada log.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include("partials/footer") %>

