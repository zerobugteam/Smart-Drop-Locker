</main>

<div id="routeAnnouncer" class="visually-hidden" aria-live="polite"></div>
<div id="consoleToast" class="console-toast" role="status" aria-live="polite"></div>

<footer class="console-footer">
  <div class="container-xl d-flex flex-wrap justify-content-between align-items-center gap-2">
    <span>Smart Drop Locker</span>
    <span>ESP32-CAM + Express + PostgreSQL</span>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
<script>
  (function () {
    var mainEl = document.getElementById("main-content");
    var progressEl = document.getElementById("navProgressBar");
    var menuBtn = document.getElementById("mobileMenuToggle");
    var drawer = document.getElementById("mobileNavDrawer");
    var announcer = document.getElementById("routeAnnouncer");
    var toastEl = document.getElementById("consoleToast");
    var toastTimer = null;
    var activeController = null;
    var lastFotoTrigger = null;
    var scanPreviewUrl = null;

    function prefersReducedMotion() {
      return window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    }

    function showToast(message) {
      if (!toastEl || !message) return;
      toastEl.textContent = message;
      toastEl.classList.add("is-visible");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(function () {
        toastEl.classList.remove("is-visible");
      }, 2600);
    }

    function syncThemeControls(theme) {
      var btn = document.querySelector("[data-theme-toggle]");
      if (!btn) return;
      var icon = btn.querySelector("[data-theme-icon]");
      var label = btn.querySelector("[data-theme-label]");
      var isLight = theme === "light";
      btn.setAttribute("aria-pressed", isLight ? "true" : "false");
      btn.setAttribute("aria-label", isLight ? "Ganti ke mode gelap" : "Ganti ke mode terang");
      if (icon) icon.className = isLight ? "bi bi-moon-stars" : "bi bi-sun";
      if (label) label.textContent = isLight ? "Mode Gelap" : "Mode Terang";
    }

    syncThemeControls(document.documentElement.getAttribute("data-theme") || "dark");

    var themeBtn = document.querySelector("[data-theme-toggle]");
    if (themeBtn) {
      themeBtn.addEventListener("click", function () {
        var next = document.documentElement.getAttribute("data-theme") === "light" ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", next);
        try { localStorage.setItem("sdl-theme", next); } catch (e) {}
        syncThemeControls(next);
        var icon = themeBtn.querySelector("[data-theme-icon]");
        if (icon && !prefersReducedMotion()) {
          icon.classList.remove("theme-icon-pop");
          void icon.offsetWidth;
          icon.classList.add("theme-icon-pop");
        }
      });
    }

    function closeDrawer(restoreFocus) {
      if (!drawer || !menuBtn) return;
      drawer.classList.remove("is-open");
      drawer.setAttribute("aria-hidden", "true");
      drawer.setAttribute("inert", "");
      menuBtn.setAttribute("aria-expanded", "false");
      if (restoreFocus) menuBtn.focus();
    }

    if (menuBtn && drawer) {
      menuBtn.addEventListener("click", function () {
        var open = drawer.classList.toggle("is-open");
        if (open) {
          drawer.removeAttribute("inert");
          drawer.setAttribute("aria-hidden", "false");
        } else {
          drawer.setAttribute("aria-hidden", "true");
          drawer.setAttribute("inert", "");
        }
        menuBtn.setAttribute("aria-expanded", open ? "true" : "false");
      });

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && drawer.classList.contains("is-open")) {
          closeDrawer(true);
        }
      });
    }

    function routeKeyForPath(pathname) {
      if (pathname === "/") return "dashboard";
      if (pathname === "/resi/add") return "resi_add";
      if (pathname.startsWith("/resi")) return "resi";
      if (pathname.startsWith("/log")) return "log";
      if (pathname.startsWith("/scan")) return "scan";
      return "";
    }

    var ROUTE_ORDER = {
      dashboard: 0,
      resi: 1,
      resi_add: 1.5,
      log: 2,
      scan: 3
    };

    function getNavDirection(fromPath, toPath) {
      var fromRank = ROUTE_ORDER[routeKeyForPath(fromPath)];
      var toRank = ROUTE_ORDER[routeKeyForPath(toPath)];
      if (typeof fromRank !== "number" || typeof toRank !== "number" || fromRank === toRank) {
        return "fade";
      }
      return toRank > fromRank ? "forward" : "back";
    }

    function applyM3Stagger(scopeEl) {
      if (!scopeEl || prefersReducedMotion()) return;
      var items = scopeEl.querySelectorAll(".console-panel, .telemetry-row, tbody tr");
      var idx = 0;
      items.forEach(function (el) {
        if (idx > 8) return;
        el.classList.add("m3-stagger");
        el.style.setProperty("--stagger", String(idx));
        idx++;
      });
    }

    function updateActiveNav(pathname) {
      var key = routeKeyForPath(pathname);
      document.querySelectorAll("header [data-nav-route]").forEach(function (el) {
        if (!el.classList.contains("nav-item-link")) return;
        var isMatch = el.getAttribute("data-nav-route") === key;
        el.classList.toggle("active", isMatch);
        if (isMatch) el.setAttribute("aria-current", "page");
        else el.removeAttribute("aria-current");
      });
    }

    function startProgress() {
      if (!progressEl) return null;
      return setTimeout(function () {
        progressEl.classList.remove("is-done");
        progressEl.classList.add("is-loading");
      }, 70);
    }

    function stopProgress(timer) {
      if (timer) clearTimeout(timer);
      if (!progressEl) return;
      progressEl.classList.remove("is-loading");
      progressEl.classList.add("is-done");
      setTimeout(function () {
        progressEl.classList.remove("is-done");
      }, 200);
    }

    function cleanupOpenModals() {
      document.querySelectorAll(".modal.show").forEach(function (m) {
        if (window.bootstrap && bootstrap.Modal) {
          var inst = bootstrap.Modal.getInstance(m);
          if (inst) inst.hide();
        }
      });
      document.querySelectorAll(".modal-backdrop").forEach(function (b) {
        b.remove();
      });
      document.body.classList.remove("modal-open");
      document.body.style.removeProperty("overflow");
      document.body.style.removeProperty("padding-right");
    }

    function applySwap(doc, urlObj, options) {
      var nextMain = doc.getElementById("main-content");
      if (!nextMain || !mainEl) return false;

      if (options.regionSelector) {
        var curRegion = mainEl.querySelector(options.regionSelector);
        var nextRegion = nextMain.querySelector(options.regionSelector);
        if (curRegion && nextRegion) {
          curRegion.innerHTML = nextRegion.innerHTML;
          if (options.push) history.pushState({}, "", urlObj.pathname + urlObj.search);
          return true;
        }
      }

      cleanupOpenModals();
      document.title = doc.title;
      mainEl.innerHTML = nextMain.innerHTML;
      updateActiveNav(urlObj.pathname);
      closeDrawer(false);

      if (options.push) {
        history.pushState({}, "", urlObj.pathname + urlObj.search + urlObj.hash);
      }
      if (!options.preserveScroll) {
        window.scrollTo({ top: 0, behavior: "instant" });
      }
      if (announcer) announcer.textContent = doc.title;
      return true;
    }

    async function navigateSoft(rawUrl, options) {
      options = options || {};
      var urlObj;
      try {
        urlObj = new URL(rawUrl, window.location.origin);
      } catch (e) {
        window.location.href = rawUrl;
        return;
      }

      if (urlObj.origin !== window.location.origin) {
        window.location.href = rawUrl;
        return;
      }

      if (activeController) activeController.abort();
      activeController = new AbortController();

      var progTimer = startProgress();
      if (mainEl && !options.regionSelector) mainEl.classList.add("is-fetching");

      try {
        var res = await fetch(urlObj.href, {
          headers: { "X-Requested-With": "soft-nav" },
          signal: activeController.signal
        });
        if (!res.ok) throw new Error("HTTP " + res.status);

        var html = await res.text();
        var doc = new DOMParser().parseFromString(html, "text/html");
        if (!doc.getElementById("main-content")) {
          window.location.href = urlObj.href;
          return;
        }

        var dir = options.regionSelector ? "fade" : getNavDirection(window.location.pathname, urlObj.pathname);
        document.documentElement.setAttribute("data-nav-dir", dir);
        if (mainEl) mainEl.setAttribute("data-nav-dir", dir);

        var doSwap = function () {
          applySwap(doc, urlObj, options);
          applyM3Stagger(options.regionSelector ? mainEl.querySelector(options.regionSelector) : mainEl);
        };

        if (!options.regionSelector && document.startViewTransition && !prefersReducedMotion()) {
          document.startViewTransition(doSwap);
        } else {
          doSwap();
          if (!options.regionSelector && mainEl && !prefersReducedMotion()) {
            mainEl.classList.remove("is-entering");
            void mainEl.offsetWidth;
            mainEl.classList.add("is-entering");
          }
        }
      } catch (err) {
        if (err && err.name === "AbortError") return;
        window.location.href = urlObj.href;
      } finally {
        if (mainEl) mainEl.classList.remove("is-fetching");
        stopProgress(progTimer);
      }
    }

    document.addEventListener("pointerdown", function (e) {
      if (prefersReducedMotion()) return;
      if (e.button !== 0 && e.pointerType === "mouse") return;
      var target = e.target.closest(".btn-console, .nav-item-link, .thumb-btn");
      if (!target || target.disabled || target.getAttribute("aria-disabled") === "true") return;

      var rect = target.getBoundingClientRect();
      var size = Math.max(rect.width, rect.height) * 2.1;
      var x = (e.clientX ? e.clientX - rect.left : rect.width / 2);
      var y = (e.clientY ? e.clientY - rect.top : rect.height / 2);

      var ripple = document.createElement("span");
      ripple.className = "m3-ripple";
      ripple.style.width = size + "px";
      ripple.style.height = size + "px";
      ripple.style.left = x + "px";
      ripple.style.top = y + "px";
      target.appendChild(ripple);
      ripple.addEventListener("animationend", function () {
        ripple.remove();
      }, { once: true });
    });

    document.addEventListener("click", function (e) {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      var link = e.target.closest("a[href]");
      if (!link) return;
      if (link.hasAttribute("download") || link.getAttribute("target") === "_blank" || link.hasAttribute("data-no-soft")) return;

      var href = link.getAttribute("href") || "";
      if (!href || href.startsWith("#") || href.startsWith("mailto:") || href.startsWith("tel:")) return;

      var targetUrl = new URL(link.href, window.location.origin);
      if (targetUrl.origin !== window.location.origin) return;

      e.preventDefault();
      navigateSoft(targetUrl.href, { push: true });
    });

    window.addEventListener("popstate", function () {
      navigateSoft(window.location.href, { push: false, preserveScroll: true });
    });

    document.addEventListener("submit", function (e) {
      var form = e.target;
      if (!form) return;

      if ((form.method || "get").toLowerCase() === "get" && form.hasAttribute("data-soft-form")) {
        e.preventDefault();
        var actionUrl = new URL(form.getAttribute("action") || window.location.pathname, window.location.origin);
        var params = new URLSearchParams(new FormData(form));
        actionUrl.search = params.toString();
        navigateSoft(actionUrl.href, {
          push: true,
          regionSelector: form.getAttribute("data-soft-target") || null,
          preserveScroll: Boolean(form.getAttribute("data-soft-target"))
        });
        return;
      }

      if ((form.method || "get").toLowerCase() === "post" && form.hasAttribute("data-soft-toggle")) {
        e.preventDefault();
        var toggleBtn = form.querySelector("button[type='submit']");
        if (toggleBtn) toggleBtn.disabled = true;
        fetch(form.action, {
          method: "POST",
          headers: { "X-Requested-With": "soft-nav" }
        }).then(function (res) {
          if (!res.ok) throw new Error("HTTP " + res.status);
          return navigateSoft(window.location.href, {
            push: false,
            regionSelector: "#resiResultsRegion",
            preserveScroll: true
          }).then(function () {
            showToast("Status resi berhasil diperbarui.");
          });
        }).catch(function () {
          form.submit();
        });
        return;
      }

      var submitBtn = form.querySelector("button[type='submit'][data-loading-text]");
      if (!submitBtn) return;
      submitBtn.disabled = true;
      submitBtn.setAttribute("aria-disabled", "true");
      submitBtn.textContent = submitBtn.getAttribute("data-loading-text");
    });

    var filterTimer = null;
    document.addEventListener("input", function (e) {
      var input = e.target;
      if (!input || !input.form || !input.form.hasAttribute("data-live-filter")) return;
      clearTimeout(filterTimer);
      filterTimer = setTimeout(function () {
        var form = input.form;
        var url = new URL(form.getAttribute("action") || window.location.pathname, window.location.origin);
        url.search = new URLSearchParams(new FormData(form)).toString();
        navigateSoft(url.href, {
          push: true,
          regionSelector: form.getAttribute("data-soft-target"),
          preserveScroll: true
        });
      }, 240);
    });

    document.addEventListener("change", function (e) {
      var el = e.target;
      if (el && el.matches("select[data-live-select]") && el.form) {
        var form = el.form;
        var url = new URL(form.getAttribute("action") || window.location.pathname, window.location.origin);
        url.search = new URLSearchParams(new FormData(form)).toString();
        navigateSoft(url.href, {
          push: true,
          regionSelector: form.getAttribute("data-soft-target"),
          preserveScroll: true
        });
        return;
      }

      if (el && el.id === "fotoInput") {
        var wrapper = document.getElementById("scanPreviewWrapper");
        var img = document.getElementById("scanPreviewImg");
        if (!wrapper || !img) return;
        if (scanPreviewUrl) {
          URL.revokeObjectURL(scanPreviewUrl);
          scanPreviewUrl = null;
        }
        var file = el.files && el.files[0];
        if (!file) {
          wrapper.setAttribute("hidden", "");
          img.src = "";
          return;
        }
        scanPreviewUrl = URL.createObjectURL(file);
        img.src = scanPreviewUrl;
        wrapper.removeAttribute("hidden");
      }
    });

    document.addEventListener("click", function (e) {
      var fotoBtn = e.target.closest("[data-foto-modal='1']");
      if (fotoBtn) {
        var fotoModalEl = document.getElementById("fotoModal");
        if (!fotoModalEl || !window.bootstrap) return;
        lastFotoTrigger = fotoBtn;
        var imgEl = document.getElementById("fotoModalImg");
        var capEl = document.getElementById("fotoModalCaption");
        if (imgEl) imgEl.src = fotoBtn.getAttribute("data-src") || "";
        if (capEl) capEl.textContent = fotoBtn.getAttribute("data-caption") || "";
        bootstrap.Modal.getOrCreateInstance(fotoModalEl).show();
      }
    });

    document.addEventListener("hidden.bs.modal", function (e) {
      if (e.target && e.target.id === "fotoModal") {
        var imgEl = document.getElementById("fotoModalImg");
        var capEl = document.getElementById("fotoModalCaption");
        if (imgEl) imgEl.src = "";
        if (capEl) capEl.textContent = "";
        if (lastFotoTrigger) {
          lastFotoTrigger.focus();
          lastFotoTrigger = null;
        }
      }
    });
  })();
</script>
</body>
</html>
